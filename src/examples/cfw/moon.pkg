import {
  "mizchi/js",
  "mizchi/js_web/http",
  "mizchi/js_web/url",
  "mizchi/js_web/streams",
  "mizchi/cloudflare",
  "mizchi/js_builtin/global",
  "mizchi/js_builtin/json",
  "mizchi/js_core" @core,
}

supported_targets = "js"

options(
  link: {
    "js": {
      "exports": [
        "get_fetch_handler",
        "get_kv_handler",
        "get_d1_handler",
        "get_r2_handler",
        "get_html_rewriter_handler",
        "get_cms_handler",
      ],
    },
  },
)
